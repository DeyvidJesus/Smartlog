rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logged() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(uid())).data; }
    function registered() { return logged() && exists(/databases/$(database)/documents/usuarios/$(uid())) && profile().get('ativo',true) != false; }
    function admin() { return registered() && profile().tipoUsuario in ['ADMIN','ADMINISTRADOR']; }
    function driver() { return registered() && profile().tipoUsuario == 'MOTORISTA'; }
    function tenant(id) { return registered() && profile().empresaId == id; }
    function sameTenant() { return tenant(resource.data.empresaId); }
    function unchangedTenant() { return request.resource.data.empresaId == resource.data.empresaId; }
    function ownDelivery() {
      return resource.data.get('motoristaId','') == uid()
        || resource.data.get('clienteId','') == uid()
        || (profile().tipoUsuario == 'CLIENTE'
          && request.auth.token.get('email','') != ''
          && resource.data.get('emailCliente','') == request.auth.token.email);
    }
    match /usuarios/{id} {
      allow get: if logged() && (id == uid() || (admin() && sameTenant()));
      allow list: if admin() && sameTenant();
      // Public signup may create only its own isolated administrator/company.
      allow create: if logged() && (
        (id == uid() && request.resource.data.empresaId == uid()
          && request.resource.data.tipoUsuario in ['ADMIN','ADMINISTRADOR'])
        || (admin() && tenant(request.resource.data.empresaId)));
      allow update: if logged() && unchangedTenant() && (
        (admin() && sameTenant())
        || (id == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','telefone','fotoUrl','email','atualizadoEm'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || request.resource.data.email == request.auth.token.get('email',''))));
      allow delete: if false;
    }
    match /empresas/{id} {
      allow get: if tenant(id);
      allow list: if false;
      allow create: if logged() && id == uid() && tenant(id) && admin();
      allow update: if admin() && tenant(id);
      allow delete: if false;
    }
    match /entregas/{id} {
      allow read: if logged() && sameTenant() && (admin() || ownDelivery());
      allow create: if admin() && tenant(request.resource.data.empresaId);
      allow update: if logged() && sameTenant() && unchangedTenant() && (
        admin() || (driver() && resource.data.get('motoristaId','') == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ordemEntrega'])));
      allow delete: if false;
    }
    match /rotas/{id} {
      allow read: if logged() && sameTenant() && (admin() || resource.data.get('motoristaId','') == uid());
      allow create: if admin() && tenant(request.resource.data.empresaId);
      allow update: if logged() && sameTenant() && unchangedTenant() && (
        admin() || (driver() && resource.data.get('motoristaId','') == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','pausadaEm','iniciadaEm','localizacaoAtual',
            'enderecos','totalEnderecos','criterioOrdenacao','otimizadaEm',
            'distanciaRestanteMetros','distanciaIncluiGps','distanciaCalculadaEm'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['distanciaRestanteMetros','distanciaIncluiGps','distanciaCalculadaEm'])
            || (request.resource.data.distanciaRestanteMetros is number
              && request.resource.data.distanciaRestanteMetros >= 0
              && request.resource.data.distanciaRestanteMetros <= 20000000
              && request.resource.data.distanciaIncluiGps is bool
              && request.resource.data.distanciaCalculadaEm == request.time))));
      allow delete: if false;
    }
    match /clientes/{id} {
      allow read: if admin() && sameTenant();
      allow create: if admin() && tenant(request.resource.data.empresaId);
      allow update: if admin() && sameTenant() && unchangedTenant();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
