# Modelo de configuração da Cloud Function do Assistente Logístico.
#
# Copie este arquivo para .env e preencha com os valores reais:
#     cp .env.example .env
#
# O .env NUNCA deve ser versionado — ele está no .gitignore.
# O Firebase CLI carrega functions/.env no deploy e transforma cada
# entrada em variável de ambiente da função.

# Obrigatória. Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Opcional. Modelo usado nas respostas. Padrão: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
